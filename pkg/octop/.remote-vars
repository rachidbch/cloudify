# pkg/octop - declared names (values live in the caller env or
# ~/.config/cloudify/pkgs/octop.yaml, never in the repo). The server reads
# exactly these env names (docs/configuration.md); the recipe default stays
# runtime truth - keep the two in sync. OCTOP_HOME's default is dynamic
# (~/.octop), hence declared optional with no mirror text.
# No credential names: first boot runs the dashboard setup wizard with a
# one-time password the recipe prints - admin creds never transit cloudify.
OCTOP_VERSION=1.0.1
OCTOP_PORT=8088
OCTOP_BIND_HOST=127.0.0.1
OCTOP_LOG_LEVEL=info
OCTOP_HOME=
